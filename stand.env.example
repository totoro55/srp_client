# Скопируйте в C:\srp-stand\.env на тестовом ПК. В git этот файл с паролями не кладите.
# Сохраните как UTF-8. Пароль без символов @ : / ? # & $ — он попадает в адрес базы.

DATABASE_URL=postgresql://postgres:ПАРОЛЬ@yug-5372-base.partner.ru:5432/srp
NEXTAUTH_URL=http://ИМЯ-ТЕСТОВОГО-ПК:3000
NEXTAUTH_SECRET=change-me-long-random-string

LDAP_URL=ldap://адрес-контроллера:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
# Логин LDAP. При старте приложение один раз назначает ему роль администратора.
DEFAULT_ADMIN_USERNAME=

# Вложения обращений, протокол S3. На этом ПК без Docker: weed mini, адрес только 127.0.0.1.
# Готовый файл MinIO для Windows больше не публикуется. На стенде с Docker сервис minio включается профилем storage.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=srp-feedback
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
