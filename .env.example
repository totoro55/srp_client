# Скопируйте в .env.local. Файл .env.local в git не попадает.

# Локальный вход без LDAP. В production обход не включается, даже если флаг стоит.
AUTH_DEV_BYPASS=true
AUTH_DEV_USERNAME=admin
AUTH_DEV_PASSWORD=admin

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/srp
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-only-change-me

# Объектное хранилище вложений, протокол S3.
# На этом ПК без Docker его поднимает SeaweedFS: weed mini, только 127.0.0.1.
# Готовый файл MinIO для Windows больше не публикуется.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=srp-feedback
S3_ACCESS_KEY=srp-local
S3_SECRET_KEY=change-me
S3_REGION=us-east-1

# Нужны только для настоящего входа через Active Directory.
# LDAP_URL=
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=
# DEFAULT_ADMIN_USERNAME=
